# Copy this to `.env` in the project root before running `docker compose up`.
# docker-compose reads this file automatically (no --env-file flag needed)
# and substitutes these into docker-compose.yml.

# --- URLs (used for OAuth redirects + CORS + the browser-facing API URL) ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string

# --- Google OAuth ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Slack OAuth ---
# Create at https://api.slack.com/apps — scopes: chat:write, incoming-webhook
# Redirect URL: http://localhost:4000/auth/slack/callback
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback
SLACK_SCOPES=chat:write,incoming-webhook

# --- Ethereal (fake SMTP) ---
# Leave blank to auto-create a fresh test inbox on first boot (check
# `docker compose logs worker` for the generated credentials + preview URL).
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Scheduler defaults (overridable per-campaign from the UI) ---
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200
WORKER_CONCURRENCY=5
