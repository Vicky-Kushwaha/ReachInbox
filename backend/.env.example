# --- Server ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
JWT_SECRET=replace-with-a-long-random-string
COOKIE_NAME=ri_session

# --- Postgres ---
DATABASE_URL=postgres://reachinbox:reachinbox@localhost:5432/reachinbox

# --- Redis (BullMQ + rate limit counters) ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# --- Ethereal (fake SMTP) ---
# Leave blank to auto-create a fresh Ethereal test account on boot (printed to console),
# or set explicit credentials from https://ethereal.email
ETHEREAL_USER=
ETHEREAL_PASS=

# --- Google OAuth (real, server-side authorization-code flow) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Slack OAuth ---
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback
# Scopes needed to post messages to a channel on the user's behalf
SLACK_SCOPES=chat:write,incoming-webhook

# --- Scheduler / rate limiting defaults (all overridable per-request) ---
DEFAULT_MIN_DELAY_MS=2000
DEFAULT_MAX_EMAILS_PER_HOUR=200
WORKER_CONCURRENCY=5
